---
/**
 * BlogPostLayout — layout cho trang chi tiết của một bài blog.
 *
 * Khác với BaseLayout: thêm khu vực hero của bài viết (title, meta)
 * và bọc nội dung trong `<div class="prose">` để typography đẹp.
 *
 * Props:
 *  - `frontmatter`: dữ liệu frontmatter của bài (title, date, …)
 */
import BaseLayout from './BaseLayout.astro';
import BackLink from '../components/shared/BackLink.astro';
import { formatDate } from '../lib/date';

export interface Props {
  frontmatter: {
    title: string;
    description: string;
    date: Date;
    readTime?: string;
    tags?: string[];
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <article class="container-reading post">
    <BackLink href="/blog" label="Quay lại Blog" />

    <header class="post-header">
      <time datetime={frontmatter.date.toISOString()} class="meta">
        {formatDate(frontmatter.date)}
        {frontmatter.readTime && <span> · {frontmatter.readTime}</span>}
      </time>
      <h1>{frontmatter.title}</h1>
      <p class="lede">{frontmatter.description}</p>
      {
        frontmatter.tags && frontmatter.tags.length > 0 && (
          <ul class="tags">
            {frontmatter.tags.map((tag) => (
              <li>#{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding-top: var(--space-9);
    padding-bottom: var(--space-8);
  }
  .post-header {
    margin-bottom: var(--space-7);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }
  .meta {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .post-header h1 {
    font-size: clamp(1.75rem, 3vw + 1rem, 2.5rem);
    color: var(--color-heading);
    margin-top: var(--space-3);
    margin-bottom: var(--space-3);
    line-height: 1.2;
  }
  .lede {
    color: var(--color-text-soft);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
  }
  .tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .tags li {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
  }
</style>
