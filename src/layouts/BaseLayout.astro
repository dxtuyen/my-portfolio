---
// Import thêm ClientRouter ở đầu file
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '../components/nav/Navbar.astro';
import Footer from '../components/shared/Footer.astro';
import AudioPlayer from '../components/audio/AudioPlayer.astro';
import { profile } from '../data/profile';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = profile.tagline } = Astro.props;
const siteName = profile.name;
const fullTitle = title === siteName ? siteName : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="vi" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Màu thanh trình duyệt (mobile, in-app browser như Zalo) -->
    <meta name="theme-color" content="#080f1e" />

    <ClientRouter />

    <title>{fullTitle}</title>

    <!-- Inline style: ngăn flash màu trắng trước khi CSS ngoài load -->
    <style is:inline>
      html { background-color: #080f1e; color-scheme: dark; }
      html[data-theme="light"] { background-color: #f4f6fa; color-scheme: light; }
    </style>

    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
          // Không có stored → giữ nguyên data-theme="dark" mặc định từ HTML
        } catch {}
      })();
    </script>
  </head>
  <body>
    <!-- Nebula background image (dark mode only) -->
    <div class="space-nebula" aria-hidden="true"></div>
    <!-- Animated starfield canvas (persists qua page transitions) -->
    <canvas id="starfield-canvas" aria-hidden="true" transition:persist></canvas>

    <div class="scroll-progress" aria-hidden="true"></div>
    <Navbar />
    <main id="main-content"><slot /></main>
    <Footer />

    <AudioPlayer />

    <script src="../scripts/theme.ts"></script>
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/menu.ts"></script>
    <script src="../scripts/effects.ts"></script>
    <script src="../scripts/starfield.ts"></script>
  </body>
</html>
