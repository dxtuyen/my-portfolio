---
// Import thêm ClientRouter ở đầu file
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '../components/nav/Navbar.astro';
import Footer from '../components/shared/Footer.astro';
import ThemeHint from '../components/theme/ThemeHint.astro';
import { profile } from '../data/profile';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = profile.tagline } = Astro.props;
const siteName = profile.name;
const fullTitle = title === siteName ? siteName : `${title} · ${siteName}`;
const ogImage = new URL('/images/og-image.svg', Astro.site).toString();
---

<!doctype html>
<html lang="vi" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Màu thanh trình duyệt (mobile, in-app browser như Zalo) -->
    <meta name="theme-color" content="#080f1e" />

    <!-- Social preview (Open Graph / Twitter Card) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <ClientRouter />

    <title>{fullTitle}</title>

    <!-- Inline style: ngăn flash màu trắng trước khi CSS ngoài load -->
    <style is:inline>
      html { background-color: #080f1e; color-scheme: dark; }
      html[data-theme="light"] { background-color: #eef6fd; color-scheme: light; }
    </style>

    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
          // Không có stored → giữ nguyên data-theme="dark" mặc định từ HTML
        } catch {}
      })();
    </script>
  </head>
  <body>
    <!-- Lớp nền: dark = ảnh vũ trụ / light = bầu trời xanh-trắng (gradient CSS) -->
    <div class="space-nebula" aria-hidden="true"></div>
    <!-- Dark: canvas sao băng | Light: canvas mây trôi (đều persist qua chuyển trang) -->
    <canvas id="starfield-canvas" aria-hidden="true" transition:persist></canvas>
    <canvas id="cloud-canvas" aria-hidden="true" transition:persist></canvas>

    <div class="scroll-progress" aria-hidden="true"></div>
    <Navbar />
    <ThemeHint />
    <main id="main-content"><slot /></main>
    <Footer />

    <script src="../scripts/theme.ts"></script>
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/menu.ts"></script>
    <script src="../scripts/effects.ts"></script>
    <script src="../scripts/starfield.ts"></script>
    <script src="../scripts/clouds.ts"></script>
  </body>
</html>
