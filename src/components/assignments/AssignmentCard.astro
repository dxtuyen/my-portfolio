---
/**
 * AssignmentCard — thẻ 1 bài tập với link tải file đính kèm.
 */
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'assignments'>;
}

const { entry } = Astro.props;
const { title, topic, description, fileUrl } = entry.data;

// Suy ra loại file từ extension để hiển thị nhãn
const ext = fileUrl.split('.').pop()?.toUpperCase() ?? 'FILE';
---

<article class="assign-card reveal">
  <div class="header">
    <span class="file-badge">{ext}</span>
    <h3 class="title">{title}</h3>
  </div>
  <p class="topic">{topic}</p>
  <p class="description">{description}</p>
  <a href={fileUrl} target="_blank" rel="noreferrer" class="download">
    ⤓ Tải file
  </a>
</article>

<style>
  .assign-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast);
  }
  .assign-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }
  .header {
    display: flex;
    align-items: start;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .file-badge {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    line-height: 1;
  }
  .title {
    color: var(--color-heading);
    font-size: var(--text-md);
    line-height: 1.3;
  }
  .topic {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
    font-style: italic;
  }
  .description {
    color: var(--color-text-soft);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-4);
  }
  .download {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    transition: gap var(--transition-fast);
  }
  .download:hover {
    gap: var(--space-3);
  }
</style>
