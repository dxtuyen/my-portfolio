---
/**
 * BackLink — link "← Quay lại" dùng đầu các trang detail.
 *
 * Props:
 *  - `href`: nơi quay về (vd: "/blog")
 *  - `label`: text hiển thị (default: "Quay lại")
 */
export interface Props {
  href: string;
  label?: string;
}

const { href, label = 'Quay lại' } = Astro.props;
---

<a href={href} class="back-link">
  <span aria-hidden="true">←</span> {label}
</a>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    margin-bottom: var(--space-5);
    transition: gap var(--transition-fast);
  }
  .back-link:hover {
    gap: var(--space-3);
  }
</style>
