---
/**
 * Footer — chân trang chung cho mọi page.
 * Hiển thị tên + tag bản quyền + năm hiện tại.
 */
import { profile } from '../../data/profile';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <p>
      Thiết kế & phát triển bởi <span class="signature">{profile.name}</span>
    </p>
    <p class="mono">Portfolio © {year} · Built with Astro</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-7) var(--space-5);
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-9);
  }
  .footer p + p {
    margin-top: var(--space-1);
  }
  .signature {
    color: var(--color-accent);
    font-weight: 500;
  }
</style>
