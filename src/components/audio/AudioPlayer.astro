---
const MUSIC_URL = '/music/background.mp3';
---

<audio-player-controller transition:persist="audio-player">
  <div class="welcome-overlay" data-welcome-overlay hidden>
    <div class="welcome-modal" role="dialog" aria-labelledby="welcome-title">
      <h2 id="welcome-title">Chào mừng bạn!</h2>
      <p>
        Bạn có muốn bật một chút nhạc nền để trải nghiệm không gian này trọn vẹn hơn không?
      </p>
      <div class="welcome-actions">
        <button type="button" class="btn-primary" data-welcome-accept>
          🎵 Bật nhạc
        </button>
        <button type="button" class="btn-secondary" data-welcome-decline>
          🔇 Không, cảm ơn
        </button>
      </div>
    </div>
  </div>

  <div class="audio-player">
    <audio data-audio src={MUSIC_URL} loop preload="metadata"></audio>
    <button
      type="button"
      class="audio-toggle-btn"
      data-audio-toggle
      aria-label="Bật/tắt nhạc nền"
      title="Bật/tắt nhạc nền"
    >
      🔇
    </button>
  </div>
</audio-player-controller>

<style>
  /* ─── Welcome modal ─── */
  .welcome-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal, 9999);
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-bg, #000) 80%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: var(--space-4, 1rem);
    animation: fade-in 300ms ease-out;
  }

  .welcome-overlay[hidden] {
    display: none !important;
  }

  .welcome-modal {
    background: var(--color-bg-elevated, #1a1a1a);
    border: 1px solid var(--color-border, #333);
    border-radius: var(--radius-lg, 8px);
    padding: var(--space-7, 2rem) var(--space-6, 1.5rem);
    text-align: center;
    max-width: 480px;
    width: 100%;
    box-shadow: var(--shadow-lg, 0 10px 15px -3px rgba(0, 0, 0, 0.5));
  }

  .welcome-modal h2 {
    color: var(--color-heading, #fff);
    margin-bottom: var(--space-3, 0.75rem);
  }

  .welcome-modal p {
    color: var(--color-text-muted, #aaa);
    margin-bottom: var(--space-5, 1.5rem);
  }

  .welcome-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3, 0.75rem);
  }

  .btn-primary,
  .btn-secondary {
    font-family: var(--font-sans, sans-serif);
    font-size: var(--text-sm, 0.875rem);
    padding: var(--space-3, 0.75rem) var(--space-5, 1.5rem);
    border-radius: var(--radius-md, 6px);
    transition: background 0.2s, color 0.2s;
    cursor: pointer;
  }
  .btn-primary {
    background: var(--color-accent, #64ffda);
    color: var(--color-bg, #0a192f);
    font-weight: 500;
    border: none;
  }
  .btn-primary:hover {
    background: var(--color-accent-strong, #5eead4);
  }
  .btn-secondary {
    background: transparent;
    color: var(--color-text, #ccd6f6);
    border: 1px solid var(--color-border-strong, #555);
  }
  .btn-secondary:hover {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  /* ─── Floating toggle button ─── */
  .audio-player {
    position: fixed;
    bottom: var(--space-5, 1.5rem);
    right: var(--space-5, 1.5rem);
    z-index: var(--z-nav, 1000);
  }

  .audio-toggle-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-accent, #64ffda);
    color: var(--color-bg, #0a192f);
    font-size: var(--text-lg, 1.25rem);
    box-shadow: var(--shadow-md);
    border: none;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .audio-toggle-btn:hover {
    transform: scale(1.08);
    box-shadow: var(--shadow-lg);
  }
  .audio-toggle-btn.is-playing {
    animation: pulse 2.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>

<script>
  const CHOICE_KEY = 'audio-choice';
  const PLAYING_KEY = 'audio-playing';

  class AudioPlayerController extends HTMLElement {
    private overlay!: HTMLElement;
    private audio!: HTMLAudioElement;
    private toggleBtn!: HTMLButtonElement;
    private acceptBtn!: HTMLButtonElement;
    private declineBtn!: HTMLButtonElement;

    connectedCallback() {
      // Guard: nếu element này đã init (transition:persist giữ lại)
      // thì chỉ đồng bộ icon, không init lại.
      if (this.dataset.ready === 'true') {
        this.syncIcon();
        return;
      }
      this.dataset.ready = 'true';

      this.overlay   = this.querySelector('[data-welcome-overlay]') as HTMLElement;
      this.audio     = this.querySelector('[data-audio]') as HTMLAudioElement;
      this.toggleBtn = this.querySelector('[data-audio-toggle]') as HTMLButtonElement;
      this.acceptBtn = this.querySelector('[data-welcome-accept]') as HTMLButtonElement;
      this.declineBtn = this.querySelector('[data-welcome-decline]') as HTMLButtonElement;

      this.init();
      this.bindEvents();

      // Mỗi lần Astro swap trang, đồng bộ lại icon với trạng thái thực của audio
      document.addEventListener('astro:after-swap', () => this.syncIcon());
    }

    // ── sessionStorage helpers ──────────────────────────────────
    private getChoice(): string | null {
      try { return sessionStorage.getItem(CHOICE_KEY); } catch { return null; }
    }
    private setChoice(v: string) {
      try { sessionStorage.setItem(CHOICE_KEY, v); } catch {}
    }
    private shouldPlay(): boolean {
      // Default true khi user chưa có lịch sử pause
      try { return sessionStorage.getItem(PLAYING_KEY) !== 'false'; } catch { return true; }
    }
    private savePlayState(playing: boolean) {
      try { sessionStorage.setItem(PLAYING_KEY, playing ? 'true' : 'false'); } catch {}
    }

    // ── UI helpers ──────────────────────────────────────────────
    private setIcon(playing: boolean) {
      this.toggleBtn.textContent = playing ? '🎵' : '🔇';
      this.toggleBtn.classList.toggle('is-playing', playing);
    }
    private syncIcon() {
      this.setIcon(!this.audio.paused);
    }

    private closeOverlay() {
      this.overlay.setAttribute('hidden', '');
      document.body.classList.remove('is-locked');
    }

    // ── Khởi tạo trạng thái ban đầu ────────────────────────────
    private init() {
      const choice = this.getChoice();

      if (choice === null) {
        // Lần đầu vào site: hỏi user
        this.overlay.removeAttribute('hidden');
        document.body.classList.add('is-locked');
        return;
      }

      if (choice === 'yes' && this.shouldPlay()) {
        // User đã chọn bật và chưa tắt
        this.audio.play()
          .then(() => this.setIcon(true))
          .catch(() => this.setIcon(false));
      } else {
        // User đã tắt hoặc chọn không
        this.setIcon(false);
      }
    }

    // ── Event listeners ─────────────────────────────────────────
    private bindEvents() {
      this.acceptBtn.addEventListener('click', () => {
        this.setChoice('yes');
        this.savePlayState(true);
        this.closeOverlay();
        this.audio.play()
          .then(() => this.setIcon(true))
          .catch(() => {});
      });

      this.declineBtn.addEventListener('click', () => {
        this.setChoice('no');
        this.savePlayState(false);
        this.closeOverlay();
      });

      this.toggleBtn.addEventListener('click', () => {
        if (this.audio.paused) {
          this.audio.play()
            .then(() => { this.setIcon(true); this.savePlayState(true); })
            .catch(() => {});
        } else {
          this.audio.pause();
          this.setIcon(false);
          this.savePlayState(false);
        }
      });
    }
  }

  if (!customElements.get('audio-player-controller')) {
    customElements.define('audio-player-controller', AudioPlayerController);
  }
</script>
