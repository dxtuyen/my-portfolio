---
/**
 * Navbar — thanh điều hướng toàn site (Hỗ trợ hiệu ứng X và Vuốt chạm Mobile).
 */
import { profile } from '../../data/profile';
import { navItems } from '../../data/navigation';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<nav class="navbar" data-navbar aria-label="Điều hướng chính">
  <a href="/" class="nav-logo" aria-label="Về trang chủ">
    <span class="bracket">&lt;</span>
    <span>{profile.shortName}</span>
    <span class="bracket">/&gt;</span>
  </a>

  <ul class="nav-links" data-menu>
    {
      navItems.map((item, index) => (
        <li>
          <a
            href={item.href}
            class:list={['nav-link', { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <span class="num">{String(index + 1).padStart(2, '0')}.</span>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="nav-actions">
    <theme-toggle>
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        aria-label="Chuyển đổi giao diện sáng/tối"
      >
        ☀
      </button>
    </theme-toggle>
    
    <button
      type="button"
      class="hamburger"
      data-menu-toggle
      aria-label="Mở menu"
      aria-expanded="false"
      aria-controls="menu"
    >
      <span class="hamburger-box">
        <span class="hamburger-inner"></span>
      </span>
    </button>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    transition: background var(--transition-base), box-shadow var(--transition-base), padding var(--transition-base);
  }

  .navbar.is-scrolled {
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--shadow-sm);
    padding-block: var(--space-3);
  }

  .nav-logo {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-heading);
    display: inline-flex;
    align-items: center;
    gap: 2px;
    text-decoration: none;
  }
  .bracket { color: var(--color-accent); }

  .nav-links {
    list-style: none;
    padding: 0;
    margin: 0;
    gap: var(--space-2);
  }

  @media (min-width: 768px) {
    .nav-links { display: flex; }
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast), background var(--transition-fast);
  }
  .nav-link:hover, .nav-link.active { color: var(--color-accent); }
  .nav-link.active { background: var(--color-accent-soft); }
  .num { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-accent); }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .theme-toggle {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-strong);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: var(--text-lg);
    cursor: pointer;
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }
  .theme-toggle:hover {
    background: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }
  .theme-toggle:active { transform: translateY(0); }

  /* Nhấp nháy vòng sáng để người dùng chú ý nút đổi giao diện (kèm gợi ý ThemeHint) */
  @keyframes theme-attn {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent) 55%, transparent); }
    70%  { box-shadow: 0 0 0 9px color-mix(in srgb, var(--color-accent) 0%, transparent); }
    100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent) 0%, transparent); }
  }
  .theme-toggle.attn {
    animation: theme-attn 1.3s ease-out 3;
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle.attn { animation: none; }
  }

  /* ─── CSS HIỆU ỨNG BIẾN HÌNH HAMBURGER THÀNH DẤU X ─── */
  .hamburger {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: background var(--transition-fast);
  }
  .hamburger:hover { background: var(--color-accent-soft); }

  .hamburger-box {
    width: 24px;
    height: 18px;
    display: inline-block;
    position: relative;
  }

  .hamburger-inner,
  .hamburger-inner::before,
  .hamburger-inner::after {
    width: 24px;
    height: 2px;
    background-color: var(--color-accent);
    position: absolute;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hamburger-inner {
    top: 50%;
    transform: translateY(-50%);
  }

  .hamburger-inner::before,
  .hamburger-inner::after {
    content: "";
    display: block;
  }

  .hamburger-inner::before { top: -8px; }
  .hamburger-inner::after { bottom: -8px; }

  /* Khi menu mở: Xoay các nét cắt tạo thành dấu X hoàn hảo */
  .hamburger[aria-expanded="true"] .hamburger-inner {
    transform: rotate(45deg);
  }
  .hamburger[aria-expanded="true"] .hamburger-inner::before {
    top: 0;
    opacity: 0; /* Ẩn thanh giữa */
  }
  .hamburger[aria-expanded="true"] .hamburger-inner::after {
    bottom: 0;
    transform: rotate(-90deg);
  }

  @media (min-width: 768px) {
    .hamburger { display: none; }
  }

  /* ─── Mobile menu CSS (Đã fix lỗi cao và tối ưu cuộn) ─── */
  @media (max-width: 767px) {
    .nav-links {
      position: fixed;
      top: 0;
      right: 0;
      width: 75%;
      max-width: 320px;
      height: 100dvh;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      will-change: transform;
      background: var(--color-bg-elevated);
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      align-items: flex-start;
      
      /* ĐÃ SỬA: Khoảng đệm lý tưởng ban đầu bình thường, có thể cuộn lên giữa trang */
      padding: 100px var(--space-6) 150px; 
      scroll-padding-bottom: 100px;
      
      gap: var(--space-4);
      transform: translateX(100%);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: var(--shadow-lg);
    }
    
    .nav-links.is-open {
      transform: translateX(0);
    }
    
    .nav-link {
      font-size: var(--text-md);
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      padding: var(--space-3);
    }
  }
</style>

<script>
  function initMobileMenu() {
    const menu = document.querySelector('[data-menu]') as HTMLElement; 
    const hamburgerBtn = document.querySelector('[data-menu-toggle]') as HTMLElement;

    if (!menu || !hamburgerBtn) return;

    if (hamburgerBtn.dataset.initialized === 'true') return;
    hamburgerBtn.dataset.initialized = 'true';

    const toggleMenu = (forceClose = false) => {
      const isOpen = menu.classList.contains('is-open');
      if (isOpen || forceClose) {
        menu.classList.remove('is-open');
        hamburgerBtn.setAttribute('aria-expanded', 'false');
      } else {
        menu.classList.add('is-open');
        hamburgerBtn.setAttribute('aria-expanded', 'true');
      }
    };

    // 1. Click nút Hamburger (Biến hình X / Menu)
    hamburgerBtn.addEventListener('click', (event) => {
      event.stopPropagation(); 
      toggleMenu();
    });

    // 2. Click ra ngoài để đóng
    document.addEventListener('click', (event) => {
      if (window.innerWidth >= 768) return; 
      const isOpen = menu.classList.contains('is-open');
      if (!isOpen) return;
      
      if (!menu.contains(event.target as Node) && !hamburgerBtn.contains(event.target as Node)) {
        toggleMenu(true);
      }
    });

    // 3. Phím ESC để đóng
    document.addEventListener('keydown', (event) => {
      if (window.innerWidth >= 768) return; 
      if (event.key === 'Escape' && menu.classList.contains('is-open')) {
        toggleMenu(true);
      }
    });

    // ─── LẬP TRÌNH HÀNH VI VUỐT CHẠM (TOUCH GESTURES) ───
    let touchStartX = 0;
    let touchEndX = 0;

    // Bắt đầu chạm ngón tay
    document.addEventListener('touchstart', (e) => {
      if (window.innerWidth >= 768) return;
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    // Nhấc ngón tay lên
    document.addEventListener('touchend', (e) => {
      if (window.innerWidth >= 768) return;
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    }, { passive: true });

    function handleSwipe() {
      const swipeDistance = touchEndX - touchStartX;
      const isOpen = menu.classList.contains('is-open');

      // Ngưỡng vuốt tối thiểu (đơn vị pixel) để tránh kích hoạt nhầm khi cuộn dọc
      const minSwipeThreshold = 60; 

      if (isOpen && swipeDistance > minSwipeThreshold) {
        // Vuốt từ trái sang phải (Swipe Right) -> Đóng menu
        toggleMenu(true);
      } else if (!isOpen && swipeDistance < -minSwipeThreshold && touchStartX > window.innerWidth * 0.8) {
        // Vuốt từ lề phải sang trái (Swipe Left từ mép màn hình) -> Mở menu
        toggleMenu();
      }
    }
  }

  document.addEventListener('astro:page-load', initMobileMenu);
</script>
