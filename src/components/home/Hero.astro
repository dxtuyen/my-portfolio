---
/**
 * Hero — block đầu tiên người dùng nhìn thấy trên trang chủ.
 */
import { profile } from '../../data/profile';
---

<section class="hero">
  <div class="container hero-content">
    <p class="hero-greeting reveal">Xin chào, tôi là</p>

    <h1 class="hero-name"><span class="text-gradient">{profile.name}</span>.</h1>

    <h2
      class="hero-tagline reveal reveal-d3"
      data-typewriter={profile.tagline2}
      aria-label={profile.tagline2}
    >{profile.tagline2}</h2>

    <p class="hero-blurb reveal reveal-d4">
      {profile.tagline}. Hiện đang theo học tại
      <a href={profile.schoolUrl} target="_blank" rel="noreferrer">
        {profile.schoolName}
      </a>. Một người có chiều sâu nội tâm, yêu thích sự tối giản và luôn tò
      mò về thế giới xung quanh.
    </p>

    <div class="hero-actions reveal reveal-d5">
      <a href="/projects" class="btn-primary" data-magnetic>Xem các dự án →</a>
      <a href="/blog" class="btn-secondary" data-magnetic>Đọc Blog</a>
    </div>
  </div>
</section>

<style>
  /* ─── Hero: full viewport, vertically centred ─── */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 64px; /* navbar height */
  }

  /* ─── Hero Content ─── */
  .hero-content {
    padding-block: var(--space-10);
    position: relative;
    isolation: isolate;
    width: 100%;
  }

  /* ─── Greeting ─── */
  .hero-greeting {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-md);
    margin-bottom: var(--space-3);
  }

  /* ─── Hero Name — CSS animation, không filter:blur để dấu không bị cắt ─── */
  @keyframes name-slide-in {
    from {
      opacity: 0;
      transform: translateY(36px);
    }
    70% {
      opacity: 1;
      transform: translateY(-4px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-name {
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: 1.15;
    padding-top: 0.1em;
    margin-bottom: var(--space-3);
    color: var(--color-heading);
    animation: name-slide-in 0.8s cubic-bezier(0.215, 0.61, 0.355, 1) 150ms both;
  }
  .hero-name .text-gradient {
    display: inline-block;
    background: linear-gradient(135deg, var(--color-heading) 25%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-name { animation: none; opacity: 1; }
  }

  /* ─── Tagline Typewriter ─── */
  .hero-tagline {
    font-size: clamp(1.125rem, 2vw + 0.5rem, 1.625rem);
    color: var(--color-text-soft);
    font-weight: 500;
    margin-bottom: var(--space-5);
    min-height: 1.4em;
  }

  @keyframes caret-blink {
    0%, 100% { border-color: var(--color-accent); }
    50% { border-color: transparent; }
  }

  .hero-tagline.is-typing {
    border-right: 2px solid var(--color-accent);
    animation: caret-blink 0.7s step-end infinite;
    padding-right: 3px;
  }

  /* ─── Blurb & Actions ─── */
  .hero-blurb {
    max-width: 600px;
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    font-size: var(--text-md);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Buttons dùng chung từ utilities.css — chỉ giữ class scoped nếu cần glow mạnh hơn */
  .hero .btn-primary:hover {
    box-shadow: 0 0 28px color-mix(in srgb, var(--color-accent) 50%, transparent), 0 8px 24px rgba(0, 0, 0, 0.35);
  }
  .hero .btn-secondary:hover {
    box-shadow: 0 0 20px color-mix(in srgb, var(--color-accent) 30%, transparent), 0 8px 20px rgba(0, 0, 0, 0.2);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const el = document.querySelector<HTMLElement>('.hero-tagline[data-typewriter]');
    if (!el) return;

    const text = el.dataset.typewriter ?? '';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    el.textContent = '';

    setTimeout(() => {
      el.classList.add('is-typing');
      let i = 0;
      const interval = setInterval(() => {
        el.textContent += text[i++];
        if (i >= text.length) {
          clearInterval(interval);
          setTimeout(() => el.classList.remove('is-typing'), 1000);
        }
      }, 55);
    }, 1150);
  });
</script>
