---
/**
 * BlogCard — preview của một bài blog trong list /blog.
 *
 * Props nhận entry từ `getCollection('blog')` và format ngày đọc.
 */
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../../lib/date';

export interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, date, readTime, tags } = entry.data;
const href = `/blog/${entry.slug}`;
---

<article class="card reveal">
  <a href={href} class="link">
    <div class="meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {readTime && <span class="dot" aria-hidden="true">·</span>}
      {readTime && <span>{readTime}</span>}
    </div>
    <h2 class="title">{title}</h2>
    <p class="excerpt">{description}</p>
    {
      tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li class="tag">#{tag}</li>
          ))}
        </ul>
      )
    }
    <span class="read-more">Đọc bài →</span>
  </a>
</article>

<style>
  .card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }
  .link {
    display: block;
    padding: var(--space-5);
    color: inherit;
  }
  .link:hover {
    color: inherit;
  }
  .meta {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    margin-bottom: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .dot {
    color: var(--color-text-muted);
  }
  .title {
    font-size: var(--text-lg);
    color: var(--color-heading);
    margin-bottom: var(--space-3);
    transition: color var(--transition-fast);
  }
  .card:hover .title {
    color: var(--color-accent);
  }
  .excerpt {
    color: var(--color-text-soft);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-4);
  }
  .tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
  }
  .read-more {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
