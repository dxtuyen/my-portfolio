---
/**
 * BookFilter — search + category filter cho trang /books.
 *
 * Hoạt động hoàn toàn client-side:
 * - Type vào input → filter theo title + author (data-search attr)
 * - Click category button → chỉ hiện sách của category đó
 * - Click "Tất cả" → reset
 *
 * Đã nâng cấp lên Web Component (<book-filter-controller>) 
 * để tương thích hoàn hảo với Astro View Transitions (ClientRouter).
 */

const categories = [
  { value: 'all', label: 'Tất cả' },
  { value: 'tech', label: 'Công nghệ' },
  { value: 'philosophy', label: 'Triết học' },
  { value: 'psychology', label: 'Tâm lý' },
  { value: 'science', label: 'Khoa học' },
  { value: 'fiction-world', label: 'Văn học thế giới' },
  { value: 'fiction-vietnam', label: 'Văn học Việt Nam' },
];
---

<book-filter-controller>
  <div class="book-filter reveal">
    <input
      type="search"
      placeholder="Tìm theo tên sách hoặc tác giả..."
      class="search-input"
      data-book-search
      aria-label="Tìm kiếm sách"
    />

    <div class="categories" role="tablist" aria-label="Lọc theo thể loại">
      {
        categories.map((cat, idx) => (
          <button
            type="button"
            class:list={['cat-btn', { active: idx === 0 }]}
            data-cat-btn
            data-cat={cat.value}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            {cat.label}
          </button>
        ))
      }
    </div>

    <p class="results-count" data-results-count></p>
  </div>
</book-filter-controller>

<style>
  .book-filter {
    margin-bottom: var(--space-6);
  }
  .search-input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: var(--text-md);
    margin-bottom: var(--space-4);
    transition: border-color var(--transition-fast);
  }
  .search-input:focus {
    border-color: var(--color-accent);
    outline: none;
  }
  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .cat-btn {
    padding: var(--space-2) var(--space-4);
    background: transparent;
    color: var(--color-text-soft);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    transition: all var(--transition-fast);
  }
  .cat-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .cat-btn.active {
    background: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
    font-weight: 500;
  }
  .results-count {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    margin-top: var(--space-4);
  }
</style>

<script>
  // Viết logic theo dạng Class Kế thừa (OOP)
  class BookFilterController extends HTMLElement {
    // connectedCallback tự động chạy mỗi khi Component xuất hiện trên màn hình
    connectedCallback() {
      // Dùng `this.querySelector` để chỉ tìm các phần tử NẰM TRONG bộ lọc này
      this.searchInput = this.querySelector('[data-book-search]');
      this.catBtns = this.querySelectorAll('[data-cat-btn]');
      this.countEl = this.querySelector('[data-results-count]');
      
      if (!this.searchInput || this.catBtns.length === 0) return;

      this.activeCategory = 'all';
      this.searchTerm = '';

      this.bindEvents();
      this.applyFilters();
    }

    applyFilters() {
      // Dùng `document.querySelectorAll` vì các cuốn sách (book-card) 
      // nằm ngoài Component này, ở một lưới (grid) riêng biệt trên DOM
      const cards = document.querySelectorAll('.book-card');
      let visibleCount = 0;

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category') ?? '';
        const search = card.getAttribute('data-search') ?? '';

        const matchCat = this.activeCategory === 'all' || cat === this.activeCategory;
        const matchSearch = this.searchTerm === '' || search.includes(this.searchTerm);

        if (matchCat && matchSearch) {
          card.classList.remove('is-hidden');
          visibleCount++;
        } else {
          card.classList.add('is-hidden');
        }
      });

      if (this.countEl) {
        this.countEl.textContent =
          visibleCount === cards.length
            ? `Hiển thị ${visibleCount} cuốn sách.`
            : `Tìm thấy ${visibleCount} / ${cards.length} cuốn sách.`;
      }
    }

    bindEvents() {
      // Sự kiện gõ phím tìm kiếm
      this.searchInput.addEventListener('input', (e) => {
        this.searchTerm = e.target.value.trim().toLowerCase();
        this.applyFilters();
      });

      // Sự kiện click nút danh mục
      this.catBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          // Xoá trạng thái active của tất cả nút
          this.catBtns.forEach((b) => {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          
          // Thêm trạng thái active cho nút vừa bấm
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
          
          this.activeCategory = btn.getAttribute('data-cat') ?? 'all';
          this.applyFilters();
        });
      });
    }
  }

  // Khai báo Component với trình duyệt
  customElements.define('book-filter-controller', BookFilterController);
</script>
