---
/**
 * BookFilter — search + category filter cho trang /books.
 *
 * Hoạt động hoàn toàn client-side:
 *  - Type vào input → filter theo title + author (data-search attr)
 *  - Click category button → chỉ hiện sách của category đó
 *  - Click "Tất cả" → reset
 *
 * Logic được viết inline trong <script> dưới đây.
 */

// Danh sách category — label tiếng Việt
const categories = [
  { value: 'all', label: 'Tất cả' },
  { value: 'tech', label: 'Công nghệ' },
  { value: 'philosophy', label: 'Triết học' },
  { value: 'psychology', label: 'Tâm lý' },
  { value: 'science', label: 'Khoa học' },
  { value: 'fiction-world', label: 'Văn học thế giới' },
  { value: 'fiction-vietnam', label: 'Văn học Việt Nam' },
];
---

<div class="book-filter reveal">
  <input
    type="search"
    placeholder="Tìm theo tên sách hoặc tác giả..."
    class="search-input"
    data-book-search
    aria-label="Tìm kiếm sách"
  />

  <div class="categories" role="tablist" aria-label="Lọc theo thể loại">
    {
      categories.map((cat, idx) => (
        <button
          type="button"
          class:list={['cat-btn', { active: idx === 0 }]}
          data-cat-btn
          data-cat={cat.value}
          role="tab"
          aria-selected={idx === 0 ? 'true' : 'false'}
        >
          {cat.label}
        </button>
      ))
    }
  </div>

  <p class="results-count" data-results-count></p>
</div>

<style>
  .book-filter {
    margin-bottom: var(--space-6);
  }
  .search-input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: var(--text-md);
    margin-bottom: var(--space-4);
    transition: border-color var(--transition-fast);
  }
  .search-input:focus {
    border-color: var(--color-accent);
    outline: none;
  }
  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .cat-btn {
    padding: var(--space-2) var(--space-4);
    background: transparent;
    color: var(--color-text-soft);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    transition: all var(--transition-fast);
  }
  .cat-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .cat-btn.active {
    background: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
    font-weight: 500;
  }
  .results-count {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    margin-top: var(--space-4);
  }
</style>

<script>
  /**
   * Client-side filter logic.
   * Đọc data-attribute trên mỗi BookCard để filter ngay trong DOM,
   * không cần render lại.
   */
  function init(): void {
    const searchInput = document.querySelector<HTMLInputElement>('[data-book-search]');
    const catBtns = document.querySelectorAll<HTMLButtonElement>('[data-cat-btn]');
    const countEl = document.querySelector<HTMLElement>('[data-results-count]');
    const cards = document.querySelectorAll<HTMLElement>('.book-card');
    if (!searchInput || catBtns.length === 0 || cards.length === 0) return;

    let activeCategory = 'all';
    let searchTerm = '';

    /** Áp dụng filter hiện tại lên toàn bộ card. */
    function applyFilters(): void {
      let visibleCount = 0;
      cards.forEach((card) => {
        const cat = card.dataset.category ?? '';
        const search = card.dataset.search ?? '';

        const matchCat = activeCategory === 'all' || cat === activeCategory;
        const matchSearch = searchTerm === '' || search.includes(searchTerm);

        if (matchCat && matchSearch) {
          card.classList.remove('is-hidden');
          visibleCount++;
        } else {
          card.classList.add('is-hidden');
        }
      });

      if (countEl) {
        countEl.textContent =
          visibleCount === cards.length
            ? `Hiển thị ${visibleCount} cuốn sách.`
            : `Tìm thấy ${visibleCount} / ${cards.length} cuốn sách.`;
      }
    }

    searchInput.addEventListener('input', (e) => {
      searchTerm = (e.target as HTMLInputElement).value.trim().toLowerCase();
      applyFilters();
    });

    catBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        catBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        activeCategory = btn.dataset.cat ?? 'all';
        applyFilters();
      });
    });

    // Trạng thái khởi tạo
    applyFilters();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
