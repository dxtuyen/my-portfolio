---
/**
 * BookCard — preview của 1 cuốn sách trong list /books.
 * Hover sẽ "lật" thẻ (3D transform) để hiện review ngắn.
 */
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'books'>;
}

const { entry } = Astro.props;
const { title, author, rating, cover, category } = entry.data;
const href = `/books/${entry.slug}`;

// Render rating thành 5 sao "lấp đầy / rỗng"
const stars = Array.from({ length: 5 }, (_, i) => i < rating);
---

<article
  class="book-card reveal"
  data-rating={rating}
  data-category={category}
  data-search={`${title} ${author}`.toLowerCase()}
>
  <a href={href} class="book-link" aria-label={`Xem ghi chú về "${title}"`}>
    <div class="cover">
      <span class="emoji" aria-hidden="true">{cover}</span>
    </div>
    <div class="info">
      <h3 class="title">{title}</h3>
      <p class="author">{author}</p>
      <div class="rating" aria-label={`Đánh giá ${rating} trên 5 sao`}>
        {
          stars.map((on) => (
            <span aria-hidden="true" class:list={{ star: true, on }}>
              ★
            </span>
          ))
        }
      </div>
    </div>
  </a>
</article>

<style>
  .book-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }
  .book-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }
  .book-link {
    display: block;
    color: inherit;
    padding: var(--space-4);
    text-align: center;
  }
  .cover {
    aspect-ratio: 2 / 3;
    background: var(--color-bg);
    border-radius: var(--radius-sm);
    display: grid;
    place-items: center;
    margin-bottom: var(--space-3);
    border: 1px solid var(--color-border);
  }
  .emoji {
    font-size: 3rem;
  }
  .title {
    color: var(--color-heading);
    font-size: var(--text-sm);
    line-height: 1.3;
    margin-bottom: var(--space-1);
    /* Cắt nếu quá dài */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .author {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    margin-bottom: var(--space-2);
    font-style: italic;
  }
  .rating {
    display: inline-flex;
    gap: 2px;
    font-size: var(--text-xs);
  }
  .star {
    color: var(--color-text-muted);
    opacity: 0.4;
  }
  .star.on {
    color: var(--color-accent);
    opacity: 1;
  }

  /* Khi card bị filter ẩn — thêm class is-hidden từ JS */
  .book-card.is-hidden {
    display: none;
  }
</style>
