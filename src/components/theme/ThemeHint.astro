---
/**
 * ThemeHint — bong bóng gợi ý nhỏ chỉ vào nút đổi giao diện ở góc trên bên phải.
 * Hiện ở trang chủ, chỉ với khách lần đầu (chưa từng đổi theme / chưa tắt gợi ý).
 * Không chặn thao tác — tự ẩn sau ít giây hoặc khi người dùng bấm tắt / bấm nút theme.
 */
---

<div id="theme-hint" class="th-hint" role="status" hidden>
  <button type="button" class="th-close" data-th-close aria-label="Đóng gợi ý">×</button>
  <span class="th-icon" aria-hidden="true">🎨</span>
  <p class="th-text">
    Bấm nút phía trên để đổi <strong>Sáng / Tối</strong> — xem thử bảng màu khác nhé!
  </p>
</div>

<style>
  .th-hint {
    position: fixed;
    top: 60px;
    right: var(--space-4);
    z-index: var(--z-toast);
    max-width: 264px;
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5) var(--space-3) var(--space-3);
    /* Dùng token theme → tối: nền sẫm + chữ sáng | sáng: nền sáng + chữ sẫm */
    background: var(--color-bg-elevated);
    color: var(--color-heading);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md);
    box-shadow:
      0 10px 26px -8px color-mix(in srgb, var(--color-accent) 32%, transparent),
      var(--shadow-lg);
    animation: th-in 0.4s cubic-bezier(0.34, 1.3, 0.7, 1);
  }
  .th-hint[hidden] { display: none; }

  /* Mũi tên (hình thoi) chỉ ngược lên nút đổi theme, khớp viền + nền thẻ */
  .th-hint::before {
    content: "";
    position: absolute;
    top: -6px;
    right: 24px;
    width: 11px;
    height: 11px;
    background: var(--color-bg-elevated);
    border-left: 1px solid var(--color-accent);
    border-top: 1px solid var(--color-accent);
    transform: rotate(45deg);
  }

  .th-icon {
    flex-shrink: 0;
    font-size: var(--text-md);
    line-height: 1.3;
  }

  .th-text {
    margin: 0;
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    font-weight: 500;
    color: var(--color-heading);
  }
  .th-text strong { font-weight: 700; color: var(--color-accent); }

  .th-close {
    position: absolute;
    top: 3px;
    right: 5px;
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast), background var(--transition-fast);
  }
  .th-close:hover { color: var(--color-heading); background: var(--color-accent-soft); }

  @media (max-width: 767px) {
    /* Mobile: nút theme nằm bên trái nút hamburger → dời mũi tên sang trái */
    .th-hint::before { right: 60px; }
  }

  @keyframes th-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .th-hint { animation: none; }
  }
</style>

<script>
  function initThemeHint() {
    const hint = document.getElementById('theme-hint');
    if (!hint) return;

    // Chỉ hiện ở trang chủ
    if (window.location.pathname !== '/') {
      hint.hidden = true;
      return;
    }

    let seen: string | null = null;
    try {
      seen = localStorage.getItem('themeHintSeen');
    } catch {}

    // Chỉ ẩn khi người dùng đã tắt gợi ý — còn lại hiện cho mọi khách (1 lần)
    if (seen === '1') {
      hint.hidden = true;
      return;
    }

    const toggle = document.querySelector('.theme-toggle');

    const dismiss = () => {
      hint.hidden = true;
      try { localStorage.setItem('themeHintSeen', '1'); } catch {}
      toggle?.classList.remove('attn');
    };

    if (hint.dataset.bound !== 'true') {
      hint.dataset.bound = 'true';
      hint.querySelector('[data-th-close]')?.addEventListener('click', dismiss);
      // Bấm vào chính nút theme cũng coi như đã hiểu gợi ý
      toggle?.addEventListener('click', dismiss, { once: true });
    }

    // Hiện gợi ý + nhấp nháy nút theme cho dễ thấy + hẹn giờ tự ẩn
    const showHint = () => {
      // Người dùng có thể đã tắt gợi ý (bấm × hoặc bấm nút theme) trong lúc chờ
      let s: string | null = null;
      try { s = localStorage.getItem('themeHintSeen'); } catch {}
      if (s === '1') return;

      hint.hidden = false;
      if (toggle) {
        toggle.classList.remove('attn');
        void (toggle as HTMLElement).offsetWidth; // ép reflow để chạy lại animation
        toggle.classList.add('attn');
      }

      // Tự ẩn sau 9 giây kể từ khi hiện nếu người dùng không tương tác
      window.setTimeout(() => {
        if (!hint.hidden) dismiss();
      }, 9000);
    };

    window.setTimeout(showHint, 900);
  }

  document.addEventListener('astro:page-load', initThemeHint);
</script>
