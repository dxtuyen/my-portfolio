---
/**
 * ProjectCard — thẻ hiển thị 1 dự án trong trang /projects.
 */
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { name, status, description, tech, github, demo } = entry.data;

// Mapping status → màu nhãn
const statusClass: Record<string, string> = {
  'Hoàn thành': 'done',
  'Đang phát triển': 'wip',
  'Ý tưởng': 'idea',
};
const cls = statusClass[status] ?? 'idea';
---

<article class="project-card reveal">
  <header class="header">
    <h3 class="title">{name}</h3>
    <span class:list={['status', cls]}>{status}</span>
  </header>

  <p class="description">{description}</p>

  <ul class="tech-list">
    {tech.map((t) => <li>{t}</li>)}
  </ul>

  <footer class="actions">
    {
      github && (
        <a href={github} target="_blank" rel="noreferrer" class="link">
          GitHub →
        </a>
      )
    }
    {
      demo && (
        <a href={demo} target="_blank" rel="noreferrer" class="link">
          Demo →
        </a>
      )
    }
  </footer>
</article>

<style>
  .project-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast);
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .project-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }
  .header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .title {
    color: var(--color-heading);
    font-size: var(--text-lg);
    flex: 1;
  }
  .status {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .status.done {
    color: var(--color-accent);
    background: var(--color-accent-soft);
  }
  .status.wip {
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.1);
  }
  .status.idea {
    color: var(--color-text-muted);
    background: var(--color-border);
  }
  .description {
    color: var(--color-text-soft);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-4);
    flex: 1;
  }
  .tech-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .tech-list li {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background: var(--color-bg);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }
  .actions {
    display: flex;
    gap: var(--space-4);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-3);
  }
  .link {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }
  .link:hover {
    color: var(--color-accent-strong);
  }
</style>
