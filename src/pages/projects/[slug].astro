---
import BaseLayout from '../../layouts/BaseLayout.astro';
// 1. THÊM HÀM render VÀO ĐÂY
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  return allProjects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { name, description } = entry.data;

// 2. SỬA CÚ PHÁP RENDER TẠI ĐÂY
const { Content } = await render(entry);
---

<BaseLayout title={name} description={description}>
  <article class="container project-detail">
    <header class="project-header">
      <a href="/projects" class="back-link">← Quay lại danh sách</a>
      <h1>{name}</h1>
      <p class="desc">{description}</p>
    </header>

    <hr class="divider" />

    <div class="markdown-content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .project-detail {
    padding: var(--space-8) 0;
    max-width: 720px;
    margin: 0 auto;
  }
  .back-link {
    display: inline-block;
    margin-bottom: var(--space-4);
    color: var(--text-muted);
    text-decoration: none;
  }
  .project-header h1 {
    font-size: 2.5rem;
    margin-bottom: var(--space-2);
    line-height: 1.2;
  }
  .divider {
    margin: var(--space-6) 0;
    border: 0;
    border-top: 1px solid var(--border-color);
  }
  .markdown-content :global(h2) {
    font-size: 1.8rem;
    margin-top: var(--space-6);
  }
  .markdown-content :global(p) {
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  /* --- BẢN VÁ LỖI RESPONSIVE TOÀN DIỆN CHO MOBILE --- */
  @media (max-width: 768px) {
    .project-detail {
      /* Tăng padding-top lên 5.5rem để đẩy toàn bộ nội dung xuống dưới, 
        tránh hoàn toàn việc bị thanh điều hướng (<Tuyen/>) che khuất.
      */
      padding: 5.5rem 1.25rem var(--space-6) 1.25rem; 
    }
    
    .project-header h1 {
      font-size: 1.75rem; /* Hạ cỡ chữ tiêu đề chính xuống để không bị thô */
      line-height: 1.3;   /* Nới rộng khoảng cách giữa các dòng của tiêu đề */
      margin-top: 0.5rem;
    }

    .project-header .desc {
      font-size: 0.95rem;   /* Thu nhỏ nhẹ đoạn mô tả dự án */
      line-height: 1.5;
      margin-top: 0.5rem;
    }

    /* Tối ưu lại toàn bộ phần nội dung Markdown từ file .md đổ ra */
    .markdown-content :global(p) {
      font-size: 1rem;
      line-height: 1.65;      /* Tăng độ giãn dòng để mắt người đọc dễ nhìn hơn */
      margin-bottom: 1.25rem; /* Tạo khoảng cách vừa vặn giữa các đoạn văn */
    }

    .markdown-content :global(h2) {
      font-size: 1.4rem;      /* Thu nhỏ các tiêu đề h2 trong bài viết */
      margin-top: 2rem;
      margin-bottom: 0.75rem;
    }
  }
</style>
