---
/**
 * Book detail page — chi tiết review của 1 cuốn sách.
 */
// 1. IMPORT HÀM RENDER CỦA ASTRO 5
import { getCollection, type CollectionEntry, render } from 'astro:content'; 
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/shared/BackLink.astro';

export async function getStaticPaths() {
  const posts = await getCollection('books', (e) => !e.data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug || post.id }, 
    // 2. TRUYỀN ĐÚNG TÊN BIẾN LÀ 'book' ĐỂ KHỚP VỚI CÚ PHÁP BÊN DƯỚI
    props: { book: post }, 
  }));
}

interface Props {
  book: CollectionEntry<'books'>;
}

const { book } = Astro.props;

// 3. SỬ DỤNG CÚ PHÁP RENDER MỚI
const { Content } = await render(book); 
const { title, author, rating, cover, category } = book.data;

const categoryLabels: Record<string, string> = {
  tech: 'Công nghệ',
  philosophy: 'Triết học',
  psychology: 'Tâm lý',
  science: 'Khoa học',
  'fiction-world': 'Văn học thế giới',
  'fiction-vietnam': 'Văn học Việt Nam',
  other: 'Khác',
};
---
