---
/**
 * Book detail page — chi tiết review của 1 cuốn sách.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/shared/BackLink.astro';

// File: [slug].astro
export async function getStaticPaths() {
  const posts = await getCollection('books', (e) => !e.data.draft);
  return posts.map((post) => ({
    // Đổi post.slug thành post.id (hoặc dùng OR để an toàn cho cả bản cũ lẫn mới)
    params: { slug: post.slug || post.id }, 
    props: { post },
  }));
}

interface Props {
  book: CollectionEntry<'books'>;
}

const { book } = Astro.props;
const { Content } = await book.render();
const { title, author, rating, cover, category } = book.data;

const categoryLabels: Record<string, string> = {
  tech: 'Công nghệ',
  philosophy: 'Triết học',
  psychology: 'Tâm lý',
  science: 'Khoa học',
  'fiction-world': 'Văn học thế giới',
  'fiction-vietnam': 'Văn học Việt Nam',
  other: 'Khác',
};
---

<BaseLayout title={title} description={`${title} — ${author}`}>
  <article class="container-reading book-detail">
    <BackLink href="/books" label="Quay lại Tủ sách" />

    <header class="book-header">
      <div class="cover" aria-hidden="true">{cover}</div>
      <div class="info">
        <p class="category">{categoryLabels[category] ?? category}</p>
        <h1>{title}</h1>
        <p class="author">{author}</p>
        <div class="rating" aria-label={`Đánh giá ${rating} trên 5 sao`}>
          {
            Array.from({ length: 5 }, (_, i) => (
              <span class:list={['star', { on: i < rating }]} aria-hidden="true">
                ★
              </span>
            ))
          }
        </div>
      </div>
    </header>

    <div class="prose review">
      <h2>Cảm nhận của tôi</h2>
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .book-detail {
    padding-top: var(--space-9);
    padding-bottom: var(--space-8);
  }
  .book-header {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: center;
    margin-bottom: var(--space-7);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 600px) {
    .book-header {
      grid-template-columns: 160px 1fr;
    }
  }
  .cover {
    aspect-ratio: 2 / 3;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: grid;
    place-items: center;
    font-size: 4rem;
    max-width: 160px;
    width: 100%;
  }
  .info .category {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    margin-bottom: var(--space-2);
  }
  .info h1 {
    font-size: clamp(1.5rem, 3vw + 0.5rem, 2.25rem);
    color: var(--color-heading);
    margin-bottom: var(--space-2);
  }
  .info .author {
    color: var(--color-text-muted);
    font-style: italic;
    margin-bottom: var(--space-3);
  }
  .rating {
    display: inline-flex;
    gap: 4px;
  }
  .star {
    color: var(--color-text-muted);
    opacity: 0.4;
    font-size: var(--text-lg);
  }
  .star.on {
    color: var(--color-accent);
    opacity: 1;
  }
  .review h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
    color: var(--color-heading);
  }
</style>
