{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "cover": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "tech",
        "philosophy",
        "psychology",
        "science",
        "fiction-world",
        "fiction-vietnam",
        "other"
      ]
    },
    "order": {
      "type": "number"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "author",
    "rating",
    "cover",
    "category"
  ]
}